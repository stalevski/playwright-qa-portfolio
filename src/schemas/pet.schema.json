{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Swagger Petstore Pet",
  "description": "Derived from the Swagger Petstore v2 'Pet' definition.",
  "type": "object",
  "required": ["id", "name", "photoUrls"],
  "properties": {
    "id": { "type": "integer" },
    "category": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "name": { "type": "string" },
    "photoUrls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      }
    },
    "status": { "type": "string", "enum": ["available", "pending", "sold"] }
  },
  "additionalProperties": true
}
